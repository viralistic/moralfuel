---
import { Image } from 'astro:assets';
import { FORMATS } from '../consts';
import { readingTime, type Post } from '../lib/posts';
import FormattedDate from './FormattedDate.astro';

interface Props {
  post: Post;
  variant?: 'row' | 'feature';
}

const { post, variant = 'row' } = Astro.props;
const { title, description, pubDate, format, tags, cover, coverAlt } = post.data;
const minutes = readingTime(post.body);
const search = [title, description, ...tags].join(' ').toLowerCase();
---

<article class:list={['card', variant]} data-post data-format={format} data-search={search}>
  {
    variant === 'feature' && cover && (
      <Image src={cover} alt={coverAlt ?? ''} widths={[640, 960, 1280]} sizes="(min-width: 60rem) 60rem, 100vw" />
    )
  }
  <div class="meta">
    <span class="badge" data-format={format}>{FORMATS[format].label}</span>
    <span class="muted"><FormattedDate date={pubDate} /> · {minutes} min read</span>
  </div>
  <h3><a href={`/blog/${post.id}/`}>{title}</a></h3>
  <p class="muted">{description}</p>
</article>

<style>
  .card {
    position: relative;
    display: grid;
    gap: 0.6rem;
    padding-block: 1.75rem;
    border-top: 1px solid var(--line);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 1rem;
    font-size: 0.85rem;
  }
  h3 {
    font-size: 1.6rem;
  }
  h3 a {
    text-decoration: none;
  }
  /* whole card clickable */
  h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .card:hover h3 a {
    color: var(--accent-ink);
  }
  p {
    max-width: 38rem;
  }
  .feature {
    padding: clamp(1.5rem, 4vw, 2.5rem);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    gap: 0.9rem;
  }
  .feature h3 {
    font-size: clamp(1.9rem, 4vw, 2.6rem);
  }
  .feature p {
    font-size: 1.1rem;
  }
  .feature :global(img) {
    border-radius: calc(var(--radius) - 4px);
    margin-bottom: 0.5rem;
  }
</style>
