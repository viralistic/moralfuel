---
interface Props {
  text: string;
  reference: string;
  translation?: string;
}
const { text, reference, translation } = Astro.props;
---

<figure class="scripture">
  <blockquote>{text}</blockquote>
  <figcaption>
    {reference}
    {translation && <span>{translation}</span>}
  </figcaption>
</figure>

<style>
  .scripture {
    margin: 0;
    padding: 1.75rem clamp(1.25rem, 4vw, 2rem);
    border-radius: var(--radius);
    background: var(--accent-soft);
  }
  blockquote {
    margin: 0;
    font-family: var(--serif);
    font-size: 1.35rem;
    font-style: italic;
    line-height: 1.5;
    color: var(--ink);
  }
  figcaption {
    margin-top: 0.9rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--accent-ink);
  }
  span {
    margin-left: 0.4rem;
    font-weight: 400;
    color: var(--muted);
  }
</style>
