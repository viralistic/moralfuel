---
import { NAV, SITE } from '../consts';
import Logo from './Logo.astro';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap grid">
    <div class="about">
      <a href="/" class="brand"><Logo size={20} /> {SITE.name}</a>
      <p class="muted">{SITE.tagline}. We make the wisdom of scripture simple to understand and practical to live.</p>
    </div>
    <nav aria-label="Footer">
      <ul>
        <li><a href="/">Home</a></li>
        {
          NAV.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
        <li><a href="/rss.xml">RSS</a></li>
      </ul>
    </nav>
  </div>
  <div class="wrap legal">
    <span>&copy; {year} {SITE.name}</span>
    <span>
      In crisis? Please contact your local emergency number or a crisis line right away. You are not alone.
    </span>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 6rem;
    border-top: 1px solid var(--line);
    padding-block: 3rem 2rem;
    font-size: 0.93rem;
  }
  .grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 2rem;
  }
  .about {
    max-width: 26rem;
    display: grid;
    gap: 0.75rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--serif);
    font-size: 1.2rem;
    text-decoration: none;
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav a {
    color: var(--muted);
    text-decoration: none;
  }
  nav a:hover {
    color: var(--ink);
  }
  .legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
    font-size: 0.82rem;
    color: var(--muted);
  }
</style>
