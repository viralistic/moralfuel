---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import PostCard from '../../components/PostCard.astro';
import Scripture from '../../components/Scripture.astro';
import Subscribe from '../../components/Subscribe.astro';
import Toc from '../../components/Toc.astro';
import { FORMATS, SITE } from '../../consts';
import { getPosts, getRelated, readingTime, slugify, type Post } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1], posts },
  }));
}

interface Props {
  post: Post;
  newer?: Post;
  older?: Post;
  posts: Post[];
}

const { post, newer, older, posts } = Astro.props;
const { title, description, pubDate, updatedDate, author, format, tags, scripture, cover, coverAlt, draft } = post.data;
const { Content, headings } = await render(post);
const minutes = readingTime(post.body);
const related = getRelated(post, posts);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  author: { '@type': 'Organization', name: author },
  publisher: { '@type': 'Organization', name: SITE.name, url: SITE.url },
  mainEntityOfPage: new URL(`/blog/${post.id}/`, SITE.url).href,
  keywords: tags.join(', '),
};
---

<Base title={title} description={description} type="article" image={cover?.src} noindex={draft}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />
  <meta property="article:published_time" content={pubDate.toISOString()} slot="head" />

  <div class="progress" aria-hidden="true"><span data-progress></span></div>

  <article class="wrap post">
    <header class="head">
      <a href="/blog" class="back muted">&larr; Journal</a>
      <div class="meta">
        <span class="badge" data-format={format}>{FORMATS[format].label}</span>
        <span class="muted">{minutes} min read</span>
        {draft && <span class="draft">Draft</span>}
      </div>
      <h1>{title}</h1>
      <p class="lead">{description}</p>
      <p class="byline muted">
        {author} · <FormattedDate date={pubDate} />
        {
          updatedDate && (
            <>
              {' '}
              · updated <FormattedDate date={updatedDate} />
            </>
          )
        }
      </p>
    </header>

    {
      cover && (
        <Image
          class="cover"
          src={cover}
          alt={coverAlt ?? ''}
          widths={[640, 960, 1280, 1600]}
          sizes="(min-width: 72rem) 72rem, 100vw"
          loading="eager"
        />
      )
    }

    <div class="body">
      <aside class="side">
        <div class="sticky"><Toc headings={headings} /></div>
      </aside>

      <div class="content">
        {scripture && <Scripture {...scripture} />}
        <div class="prose"><Content /></div>

        <footer class="post-foot">
          {
            tags.length > 0 && (
              <ul class="tags" aria-label="Topics">
                {tags.map((tag) => (
                  <li>
                    <a class="chip" href={`/blog/tag/${slugify(tag)}/`}>
                      {tag}
                    </a>
                  </li>
                ))}
              </ul>
            )
          }
          <button class="chip share" type="button" data-share>Copy link</button>
        </footer>

        {
          (newer || older) && (
            <nav class="pager" aria-label="More lessons">
              {older ? (
                <a href={`/blog/${older.id}/`} rel="prev">
                  <span class="muted">Previous</span>
                  {older.data.title}
                </a>
              ) : (
                <span />
              )}
              {newer && (
                <a href={`/blog/${newer.id}/`} rel="next" class="next">
                  <span class="muted">Next</span>
                  {newer.data.title}
                </a>
              )}
            </nav>
          )
        }
      </div>
    </div>
  </article>

  <div class="wrap">
    {
      related.length > 0 && (
        <section class="related" aria-labelledby="related-title">
          <h2 id="related-title">Keep reading</h2>
          <div>
            {related.map((p) => (
              <PostCard post={p} />
            ))}
          </div>
        </section>
      )
    }
    <Subscribe />
  </div>
</Base>

<script>
  const bar = document.querySelector<HTMLElement>('[data-progress]');
  const content = document.querySelector<HTMLElement>('.content');
  if (bar && content) {
    const update = () => {
      const rect = content.getBoundingClientRect();
      const total = rect.height - window.innerHeight;
      const p = total > 0 ? Math.min(1, Math.max(0, -rect.top / total)) : 1;
      bar.style.transform = `scaleX(${p})`;
    };
    update();
    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
  }

  document.querySelector<HTMLButtonElement>('[data-share]')?.addEventListener('click', async (e) => {
    const btn = e.currentTarget as HTMLButtonElement;
    const url = location.href.split('#')[0];
    try {
      if (navigator.share && matchMedia('(pointer: coarse)').matches) {
        await navigator.share({ title: document.title, url });
        return;
      }
      await navigator.clipboard.writeText(url);
      btn.textContent = 'Link copied';
      setTimeout(() => (btn.textContent = 'Copy link'), 2000);
    } catch {}
  });
</script>

<style>
  .progress {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    z-index: 60;
  }
  .progress span {
    display: block;
    height: 100%;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: 0 50%;
  }
  .head {
    display: grid;
    gap: 1.1rem;
    max-width: 48rem;
    margin-inline: auto;
    padding-block: clamp(2.5rem, 7vw, 5rem) clamp(2rem, 5vw, 3rem);
    text-align: center;
    justify-items: center;
  }
  .back {
    font-size: 0.9rem;
    text-decoration: none;
  }
  .back:hover {
    color: var(--ink);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0.5rem 1rem;
    font-size: 0.85rem;
  }
  .draft {
    padding: 0.1rem 0.5rem;
    border-radius: 6px;
    background: var(--accent-soft);
    color: var(--accent-ink);
    font-size: 0.75rem;
    font-weight: 600;
  }
  h1 {
    font-size: clamp(2.3rem, 6.5vw, 4.2rem);
  }
  .lead {
    font-family: var(--serif);
    font-size: clamp(1.2rem, 2.4vw, 1.45rem);
    color: var(--muted);
    max-width: 38rem;
  }
  .byline {
    font-size: 0.88rem;
  }
  .cover {
    width: 100%;
    border-radius: var(--radius);
    margin-bottom: 3rem;
  }
  .body {
    display: grid;
    grid-template-columns: minmax(0, var(--measure));
    justify-content: center;
    gap: 4rem;
  }
  .side {
    display: none;
  }
  @media (min-width: 68rem) {
    .body {
      grid-template-columns: 13rem minmax(0, var(--measure)) 13rem;
    }
    .side {
      display: block;
    }
  }
  .sticky {
    position: sticky;
    top: 6rem;
  }
  .content > :global(.scripture) {
    margin-bottom: 2.5rem;
  }
  .post-foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-top: 3.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 2.5rem;
  }
  .pager a {
    display: grid;
    gap: 0.25rem;
    padding: 1.1rem 1.25rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    font-family: var(--serif);
    font-size: 1.1rem;
    line-height: 1.3;
    text-decoration: none;
    transition: border-color 0.2s;
  }
  .pager a:hover {
    border-color: var(--ink);
  }
  .pager span.muted {
    font-family: var(--sans);
    font-size: 0.78rem;
  }
  .pager .next {
    text-align: right;
  }
  @media (max-width: 40rem) {
    .pager {
      grid-template-columns: 1fr;
    }
    .pager .next {
      text-align: left;
    }
  }
  .related {
    margin-block: 6rem 5rem;
  }
  .related h2 {
    font-size: 2rem;
    margin-bottom: 1.5rem;
  }
  .related > div {
    border-bottom: 1px solid var(--line);
  }
</style>
