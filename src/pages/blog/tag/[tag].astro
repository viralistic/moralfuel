---
import Base from '../../../layouts/Base.astro';
import PostCard from '../../../components/PostCard.astro';
import { getPosts, getTags, slugify, type Post } from '../../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return getTags(posts).map(({ tag, slug }) => ({
    params: { tag: slug },
    props: { tag, posts: posts.filter((p) => p.data.tags.some((t) => slugify(t) === slug)) },
  }));
}

interface Props {
  tag: string;
  posts: Post[];
}
const { tag, posts } = Astro.props;
---

<Base title={`Lessons on ${tag}`} description={`Every MoralFuel lesson about ${tag}.`}>
  <div class="wrap">
    <header class="intro">
      <a href="/blog" class="muted back">&larr; All lessons</a>
      <p class="eyebrow">Topic</p>
      <h1>{tag}</h1>
      <p class="muted">{posts.length} {posts.length === 1 ? 'lesson' : 'lessons'}</p>
    </header>
    <div class="list">
      {posts.map((post) => <PostCard post={post} />)}
    </div>
  </div>
</Base>

<style>
  .intro {
    display: grid;
    gap: 0.75rem;
    padding-block: clamp(3rem, 8vw, 5rem) 2.5rem;
  }
  .back {
    font-size: 0.9rem;
    text-decoration: none;
    margin-bottom: 1rem;
  }
  h1 {
    font-size: clamp(2.4rem, 6vw, 3.6rem);
    text-transform: capitalize;
  }
  .list {
    border-bottom: 1px solid var(--line);
  }
</style>
